# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the Orchestrator and Knowledge Expert
ANTHROPIC_MODEL=claude-opus-4-8

# Salesforce CLI target org alias or username (the org `sf` will query).
# Must match an org already authenticated via `sf org login web`.
SF_TARGET_ORG=my-org-alias
